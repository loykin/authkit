{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@loykin/authkit": ["../src/index.ts"],
      "@loykin/authkit/react": ["../src/react/index.ts"],
      "@loykin/authkit/testing": ["../src/testing/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
